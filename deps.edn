{:paths ["src"]

 ;; No IO dependencies: the engine is pure, and inference is a protocol
 ;; (hyd.llm/Intuition) the embedding application implements. HTTP, JSON
 ;; and clock shims belong to the adapters — see examples/incident.

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.jlt-commons/writ
                      {:git/url "https://github.com/jlt-commons/writ"
                       :git/sha "57d863b290e7abe9f2918f969c2a6c74ee6d5a21"}}
         :main-opts ["-m" "hyd.test-runner"]}
  :check {:extra-paths ["test"]
          :extra-deps {io.github.jlt-commons/writ
                       {:git/url "https://github.com/jlt-commons/writ"
                        :git/sha "57d863b290e7abe9f2918f969c2a6c74ee6d5a21"}}
          :main-opts ["-m" "hyd.spec-check"]}
  :run {:main-opts ["-m" "hyd.main"]}}}
